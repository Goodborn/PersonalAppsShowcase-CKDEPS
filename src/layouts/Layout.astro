---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Apps I Use — Goodborn",
  description = "Curated apps that power my workflow — and why I chose them.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseURL = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseURL}favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="relative">
    <div
      class="pointer-events-none fixed inset-0 -z-10"
      aria-hidden="true"
    >
      <div
        class="absolute -top-40 left-1/2 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-glow-purple/5 blur-[140px]"
      ></div>
      <div
        class="absolute bottom-0 left-0 h-[200px] w-[300px] rounded-full bg-glow-indigo/3 blur-[100px]"
      ></div>
      <div
        class="absolute right-0 top-1/3 h-[200px] w-[300px] rounded-full bg-glow-sky/3 blur-[100px]"
      ></div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>